---
import { getCollection, render } from "astro:content";
import ShareButton from "../../../components/ShareButton.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articleSlug, articlesForLanguage, SUPPORTED_LANGUAGES, tagUrl, type Language } from "../../../lib/articles";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return SUPPORTED_LANGUAGES.filter((language) => language !== "en").flatMap((language) =>
    articlesForLanguage(articles, language).map((article) => ({
      params: { language, slug: articleSlug(article) },
      props: { article },
    })),
  );
}

const { article } = Astro.props;
const language = Astro.params.language as Exclude<Language, "en">;
const { Content } = await render(article);
const formattedDate = article.data.publishedAt.toLocaleDateString(language === "hi" ? "hi-IN" : "bn-BD", { month: "long", day: "numeric", year: "numeric" });
---

<BaseLayout title={`${article.data.title} | Saral`} description={article.data.summary} socialImage={article.data.socialImage ?? article.data.image} socialImageAlt={article.data.imageAlt} {language}>
  <SiteHeader {language} currentPath={Astro.url.pathname} />
  <main class="shell article-shell"><a class="back-link" href={`/${language}/`}>← {language === "hi" ? "सभी पाठ" : "সব পাঠ"}</a><article class="lesson"><header><div class="tag-row">{article.data.tags.map((tag) => <a class="tag" href={tagUrl(tag, language)}>{tag}</a>)}</div><h1>{article.data.title}</h1><p class="article-summary">{article.data.summary}</p><div class="article-meta"><span>{language === "hi" ? "प्रकाशित" : "প্রকাশিত"} {formattedDate}</span><ShareButton title={article.data.title} /></div></header><figure class="lesson-visual"><img src={article.data.image} alt={article.data.imageAlt} /></figure><div class="lesson-content"><Content /></div><aside class="gentle-note"><strong>{language === "hi" ? "याद रखें" : "মনে রাখবেন"}</strong><p>{language === "hi" ? "आप एक समय में एक कदम सीख सकते हैं।" : "আপনি একবারে এক ধাপ শিখতে পারেন।"}</p></aside></article></main>
</BaseLayout>
