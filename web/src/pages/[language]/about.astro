---
import { getCollection } from "astro:content";
import BackToTop from "../../components/BackToTop.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleUrl, articlesForLanguage, sortArticles } from "../../lib/articles";
import { costForArticle, formatUsd } from "../../lib/generation-costs";
import { SUPPORTED_LANGUAGES, ui, type Language } from "../../lib/i18n";

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.filter((language) => language !== "en").map((language) => ({ params: { language } }));
}

const language = Astro.params.language as Exclude<Language, "en">;
const text = ui(language);
const allArticles = await getCollection("articles");
const articles = sortArticles(articlesForLanguage(allArticles, language));
---

<BaseLayout title={`${text.aboutPageTitle} | Saral`} description={text.aboutPageDescription} pageClass="about-page" {language}>
  <SiteHeader {language} currentPath={Astro.url.pathname} />
  <main class="shell about-shell">
    <p class="kicker">{text.aboutSaral}</p>
    <p class="about-intro">{text.aboutIntro}</p>
    <section class="about-goals" aria-labelledby="goals-title">
      <h2 id="goals-title">{text.aboutGoalHeading}</h2>
      <ul>
        <li>{text.aboutGoalOne}</li>
        <li>{text.aboutGoalTwo}</li>
        <li>{text.aboutGoalThree}</li>
        <li>{text.aboutGoalFour}</li>
      </ul>
    </section>
    <section class="about-costs" id="ai-production-costs" aria-labelledby="costs-title">
      <p class="kicker">{text.aiProductionCosts}</p>
      <h2 id="costs-title">{text.aiProductionCosts}</h2>
      <p>{text.costTransparencyIntro}</p>
      <div class="about-cost-list">{articles.map((article) => {
        const cost = costForArticle(article, allArticles);
        const amount = cost ? `${formatUsd(cost.totalUsd, language)}${cost.costStatus === "partial" ? "+" : ""}` : text.costDataUnavailableShort;
        return <div><span>{article.data.title}</span>{cost ? <a href={`${articleUrl(article)}#ai-production-cost`}>{amount}</a> : <span class="cost-data-unavailable">{amount}</span>}</div>;
      })}</div>
    </section>
  </main>
  <BackToTop {language} />
</BaseLayout>
