---
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../lib/i18n";

const text = ui("en");
---

<BaseLayout title={`${text.aboutPageTitle} | Saral`} description={text.aboutPageDescription} pageClass="about-page">
  <SiteHeader language="en" currentPath={Astro.url.pathname} />
  <main class="shell about-shell">
    <p class="kicker">{text.aboutSaral}</p>
    <p class="about-intro">{text.aboutIntro}</p>
    <section class="about-goals" aria-labelledby="goals-title">
      <h2 id="goals-title">{text.aboutGoalHeading}</h2>
      <ul>
        <li>{text.aboutGoalOne}</li>
        <li>{text.aboutGoalTwo}</li>
        <li>{text.aboutGoalThree}</li>
        <li>{text.aboutGoalFour}</li>
      </ul>
    </section>
  </main>
</BaseLayout>
