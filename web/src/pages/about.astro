---
import { getCollection } from "astro:content";
import AboutSectionNav from "../components/AboutSectionNav.astro";
import BackToTop from "../components/BackToTop.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TechOverview from "../components/TechOverview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { articleUrl, articlesForLanguage, sortArticles } from "../lib/articles";
import { costForArticle, formatUsd } from "../lib/generation-costs";
import { ui } from "../lib/i18n";

const text = ui("en");
const allArticles = await getCollection("articles");
const articles = sortArticles(articlesForLanguage(allArticles, "en"));
const recordedCosts = articles.flatMap((article) => {
  const cost = costForArticle(article, allArticles);
  return cost ? [cost.totalUsd] : [];
});
const averageCost = recordedCosts.length ? recordedCosts.reduce((total, cost) => total + cost, 0) / recordedCosts.length : undefined;
---

<BaseLayout title={`${text.aboutPageTitle} | Saral`} description={text.aboutPageDescription} pageClass="about-page">
  <SiteHeader language="en" currentPath={Astro.url.pathname} />
  <main class="shell about-shell">
    <AboutSectionNav language="en" />
    <section class="about-introduction" id="about-introduction">
      <p class="kicker">{text.aboutSaral}</p>
      <p class="about-intro">{text.aboutIntro}</p>
    </section>
    <section class="about-goals" id="our-goal" aria-labelledby="goals-title">
      <h2 id="goals-title">{text.aboutGoalHeading}</h2>
      <ul>
        <li>{text.aboutGoalOne}</li>
        <li>{text.aboutGoalTwo}</li>
        <li>{text.aboutGoalThree}</li>
        <li>{text.aboutGoalFour}</li>
      </ul>
    </section>
    <TechOverview language="en" {averageCost} />
    <section class="about-costs" id="ai-production-costs" aria-labelledby="costs-title">
      <!--h2 id="costs-title">{text.aiProductionCosts}</h2-->
      <p class="kicker" id="costs-title">{text.aiProductionCosts}</p>
      <p>{text.costTransparencyIntro}</p>
      <div class="about-cost-list">{articles.map((article) => {
        const cost = costForArticle(article, allArticles);
        const amount = cost ? `${formatUsd(cost.totalUsd, "en")}${cost.costStatus === "partial" ? "+" : ""}` : text.costDataUnavailableShort;
        return <div><span>{article.data.title}</span>{cost ? <a href={`${articleUrl(article)}#ai-production-cost`}>{amount}</a> : <span class="cost-data-unavailable">{amount}</span>}</div>;
      })}</div>
    </section>
  </main>
  <BackToTop language="en" />
</BaseLayout>
