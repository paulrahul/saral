---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articlesForLanguage, sortArticles, SUPPORTED_LANGUAGES, tagUrl, translatedTag } from "../../lib/articles";
import { ui } from "../../lib/i18n";

const allArticles = await getCollection("articles");
const articles = articlesForLanguage(allArticles, "en");
export async function getStaticPaths() {
  const entries = await getCollection("articles");
  const tags = [...new Set(articlesForLanguage(entries, "en").flatMap((article) => article.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}
const tag = Astro.params.tag ?? "";
const matchingArticles = sortArticles(articles.filter((article) => article.data.tags.includes(tag)));
const languagePaths = Object.fromEntries(SUPPORTED_LANGUAGES.map((targetLanguage) => {
  const targetTag = translatedTag(allArticles, "en", tag, targetLanguage);
  return [targetLanguage, targetTag ? tagUrl(targetTag, targetLanguage) : targetLanguage === "en" ? "/" : `/${targetLanguage}/`];
}));
const text = ui("en");
---

<BaseLayout title={`${tag} | Saral`}><SiteHeader language="en" currentPath={Astro.url.pathname} {languagePaths} /><main class="shell tag-page"><a class="back-link" href="/">← {text.allLessons}</a><p class="kicker">{text.topic}</p><h1>{tag}</h1><div class="article-list">{matchingArticles.map((article) => <ArticleCard {article} />)}</div></main></BaseLayout>
