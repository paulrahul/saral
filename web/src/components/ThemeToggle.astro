---
import { Moon, Sun } from "lucide-astro";
---

<button class="icon-button" type="button" data-theme-toggle aria-label="Use dark mode" title="Use dark mode">
  <Sun data-sun aria-hidden="true" size={20} />
  <Moon data-moon aria-hidden="true" size={20} />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    button?.setAttribute("aria-label", theme === "dark" ? "Use light mode" : "Use dark mode");
    button?.setAttribute("title", theme === "dark" ? "Use light mode" : "Use dark mode");
  };

  const savedTheme = localStorage.getItem("easytutor-theme");
  setTheme(savedTheme === "dark" || (!savedTheme && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light");
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("easytutor-theme", next);
    setTheme(next);
  });
</script>
