---
import type { CollectionEntry } from "astro:content";
import { articleSlug } from "../lib/articles";
const { article } = Astro.props as { article: CollectionEntry<"articles"> };
const formattedDate = article.data.publishedAt.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" });
const href = `/articles/${articleSlug(article)}/`;
---

<article class="article-card">
  <a class="card-image" href={href} tabindex="-1"><img src={article.data.image} alt="" /></a>
  <div class="card-copy">
    <div class="eyebrow-row"><span>{article.data.tags[0]}</span><span>{formattedDate}</span></div>
    <h2><a href={href}>{article.data.title}</a></h2>
    <p>{article.data.summary}</p>
    <a class="read-link" href={href}>Read this lesson <span aria-hidden="true">→</span></a>
  </div>
</article>
