---
import { Moon, Sun } from "lucide-astro";
import { locale, SUPPORTED_LANGUAGES, ui, type Language } from "../lib/i18n";

interface Props {
  language?: Language;
  currentPath?: string;
  languagePaths?: Partial<Record<Language, string>>;
}

const { language = "en", currentPath = "/", languagePaths = {} } = Astro.props;
const contentPath = currentPath.replace(new RegExp(`^/(?:${SUPPORTED_LANGUAGES.filter((code) => code !== "en").join("|")})(?=/|$)`), "") || "/";
const languagePath = (targetLanguage: Language) => languagePaths[targetLanguage] ?? (targetLanguage === "en" ? contentPath : `/${targetLanguage}${contentPath}`);
const labels = ui(language);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={language === "en" ? "/" : `/${language}/`} aria-label={`Saral: ${labels.home}`}><img src="/saral-logo.png" alt="" width="640" height="183" /><small>{labels.tagline}</small></a>
    <nav aria-label={labels.mainNavigation}><a href={language === "en" ? "/" : `/${language}/`}>{labels.home}</a><a href={language === "en" ? "/about/" : `/${language}/about/`}>{labels.aboutSaral}</a></nav>
    <div class="language-list" role="group" aria-label={labels.chooseLanguage}>
      {SUPPORTED_LANGUAGES.map((targetLanguage) => <a data-language={targetLanguage} aria-current={language === targetLanguage ? "page" : undefined} href={languagePath(targetLanguage)}>{locale(targetLanguage).name}</a>)}
    </div>
    <button class="theme-toggle" type="button" data-theme-toggle data-light-label={labels.useLightTheme} data-dark-label={labels.useDarkTheme} aria-label={labels.useDarkTheme} title={labels.useDarkTheme}>
      <Sun data-sun aria-hidden="true" size={20} />
      <Moon data-moon aria-hidden="true" size={20} />
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => link.addEventListener("click", () => {
    localStorage.setItem("saral-language", link.dataset.language ?? "en");
  }));

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    const label = theme === "dark" ? themeButton?.dataset.lightLabel ?? "" : themeButton?.dataset.darkLabel ?? "";
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };
  const savedTheme = localStorage.getItem("saral-theme");
  setTheme(savedTheme === "dark" ? "dark" : "light");
  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("saral-theme", next);
    setTheme(next);
  });
</script>
