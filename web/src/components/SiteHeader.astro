---
import { Moon, Sun } from "lucide-astro";

interface Props {
  language?: "en" | "hi" | "bn";
  currentPath?: string;
}

const { language = "en", currentPath = "/" } = Astro.props;
const contentPath = currentPath.replace(/^\/(?:hi|bn)(?=\/|$)/, "") || "/";
const languagePath = (targetLanguage: "en" | "hi" | "bn") => targetLanguage === "en" ? contentPath : `/${targetLanguage}${contentPath}`;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={language === "en" ? "/" : `/${language}/`} aria-label="Saral home"><span>Saral</span><small>Small lessons for everyday digital life.</small></a>
    <nav aria-label="Main navigation"><a href={language === "en" ? "/" : `/${language}/`}>Home</a><a href={`${language === "en" ? "" : `/${language}`}/#topics`}>All topics</a></nav>
    <div class="language-list" role="group" aria-label="Choose language">
      <a data-language="en" aria-current={language === "en" ? "page" : undefined} href={languagePath("en")}>English</a>
      <a data-language="hi" aria-current={language === "hi" ? "page" : undefined} href={languagePath("hi")}>हिन्दी</a>
      <a data-language="bn" aria-current={language === "bn" ? "page" : undefined} href={languagePath("bn")}>বাংলা</a>
    </div>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use dark theme" title="Use dark theme">
      <Sun data-sun aria-hidden="true" size={20} />
      <Moon data-moon aria-hidden="true" size={20} />
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => link.addEventListener("click", () => {
    localStorage.setItem("saral-language", link.dataset.language ?? "en");
  }));

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    const label = theme === "dark" ? "Use light theme" : "Use dark theme";
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };
  const savedTheme = localStorage.getItem("saral-theme");
  setTheme(savedTheme === "dark" || (!savedTheme && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light");
  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("saral-theme", next);
    setTheme(next);
  });
</script>
