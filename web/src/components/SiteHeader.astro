---
import { Moon, Sun } from "lucide-astro";

interface Props {
  language?: "en" | "hi" | "bn";
  currentPath?: string;
  languagePaths?: Partial<Record<"en" | "hi" | "bn", string>>;
}

const { language = "en", currentPath = "/", languagePaths = {} } = Astro.props;
const contentPath = currentPath.replace(/^\/(?:hi|bn)(?=\/|$)/, "") || "/";
const languagePath = (targetLanguage: "en" | "hi" | "bn") => languagePaths[targetLanguage] ?? (targetLanguage === "en" ? contentPath : `/${targetLanguage}${contentPath}`);
const labels = {
  en: { home: "Home", topics: "All topics", language: "Choose language", light: "Use light theme", dark: "Use dark theme", tagline: "AI made simple, so no one is left behind." },
  hi: { home: "मुख्य पृष्ठ", topics: "सभी विषय", language: "भाषा चुनें", light: "हल्की थीम इस्तेमाल करें", dark: "गहरी थीम इस्तेमाल करें", tagline: "एआई आसान भाषा में, ताकि कोई पीछे न छूटे।" },
  bn: { home: "মূল পাতা", topics: "সব বিষয়", language: "ভাষা বেছে নিন", light: "হালকা থিম ব্যবহার করুন", dark: "গাঢ় থিম ব্যবহার করুন", tagline: "সহজ ভাষায় এআই, যাতে কেউ পিছিয়ে না থাকে।" },
}[language];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={language === "en" ? "/" : `/${language}/`} aria-label="Saral home"><img src="/saral-logo.png" alt="" width="640" height="183" /><small>{labels.tagline}</small></a>
    <nav aria-label="Main navigation"><a href={language === "en" ? "/" : `/${language}/`}>{labels.home}</a><a href={`${language === "en" ? "" : `/${language}`}/#topics`}>{labels.topics}</a></nav>
    <div class="language-list" role="group" aria-label={labels.language}>
      <a data-language="en" aria-current={language === "en" ? "page" : undefined} href={languagePath("en")}>English</a>
      <a data-language="hi" aria-current={language === "hi" ? "page" : undefined} href={languagePath("hi")}>हिन्दी</a>
      <a data-language="bn" aria-current={language === "bn" ? "page" : undefined} href={languagePath("bn")}>বাংলা</a>
    </div>
    <button class="theme-toggle" type="button" data-theme-toggle data-light-label={labels.light} data-dark-label={labels.dark} aria-label={labels.dark} title={labels.dark}>
      <Sun data-sun aria-hidden="true" size={20} />
      <Moon data-moon aria-hidden="true" size={20} />
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => link.addEventListener("click", () => {
    localStorage.setItem("saral-language", link.dataset.language ?? "en");
  }));

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    const label = theme === "dark" ? themeButton?.dataset.lightLabel ?? "Use light theme" : themeButton?.dataset.darkLabel ?? "Use dark theme";
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };
  const savedTheme = localStorage.getItem("saral-theme");
  setTheme(savedTheme === "dark" || (!savedTheme && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light");
  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("saral-theme", next);
    setTheme(next);
  });
</script>
